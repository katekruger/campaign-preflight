{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/katekruger/campaign-preflight/schemas/report-1.0.0.json",
  "title": "Campaign Preflight report",
  "description": "The JSON envelope emitted by `campaign-preflight --format json`. Version 1.0.0.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_schema_version",
    "tool_version",
    "generated_at",
    "provider",
    "campaign",
    "readiness",
    "score",
    "confidence",
    "score_breakdown",
    "counts",
    "results",
    "limitations",
    "redacted"
  ],
  "properties": {
    "report_schema_version": { "type": "string", "const": "1.0.0" },
    "tool_version": { "type": "string" },
    "generated_at": { "type": "string", "format": "date-time" },
    "snapshot_note": { "type": "string" },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "read_only", "errors"],
      "properties": {
        "name": { "type": "string" },
        "read_only": { "type": "boolean", "const": true },
        "errors": { "type": "array", "items": { "type": "string" } }
      }
    },
    "campaign": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "status"],
      "properties": {
        "id": { "type": ["string", "null"] },
        "name": { "type": ["string", "null"] },
        "status": { "type": ["string", "null"] }
      }
    },
    "readiness": {
      "type": "string",
      "enum": ["READY", "READY_WITH_WARNINGS", "NOT_READY", "INCOMPLETE"]
    },
    "score": { "type": "integer", "minimum": 0, "maximum": 100 },
    "confidence": { "type": "string", "enum": ["HIGH", "MEDIUM", "LOW"] },
    "score_breakdown": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "starting_score",
        "final_score",
        "explanation",
        "deductions",
        "excluded_rule_ids",
        "critical_unknown_rule_ids"
      ],
      "properties": {
        "starting_score": { "type": "number" },
        "final_score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "explanation": { "type": "string" },
        "deductions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["rule_id", "status", "severity", "points", "reason"],
            "properties": {
              "rule_id": { "type": "string" },
              "status": { "type": "string", "enum": ["FAIL", "WARN"] },
              "severity": {
                "type": "string",
                "enum": ["INFO", "LOW", "MEDIUM", "HIGH", "BLOCKER"]
              },
              "points": { "type": "number", "minimum": 0 },
              "reason": { "type": "string" }
            }
          }
        },
        "excluded_rule_ids": { "type": "array", "items": { "type": "string" } },
        "critical_unknown_rule_ids": { "type": "array", "items": { "type": "string" } }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "leads",
        "leads_partial",
        "senders",
        "suppressions",
        "blockers",
        "failures",
        "warnings",
        "unknown",
        "passed",
        "not_applicable"
      ],
      "properties": {
        "leads": { "type": "integer", "minimum": 0 },
        "leads_partial": { "type": "boolean" },
        "senders": { "type": "integer", "minimum": 0 },
        "suppressions": { "type": "integer", "minimum": 0 },
        "blockers": { "type": "integer", "minimum": 0 },
        "failures": { "type": "integer", "minimum": 0 },
        "warnings": { "type": "integer", "minimum": 0 },
        "unknown": { "type": "integer", "minimum": 0 },
        "passed": { "type": "integer", "minimum": 0 },
        "not_applicable": { "type": "integer", "minimum": 0 }
      }
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rule_id",
          "rule_version",
          "title",
          "category",
          "severity",
          "status",
          "summary",
          "affected_record_count",
          "affected_record_samples",
          "remediation"
        ],
        "properties": {
          "rule_id": { "type": "string", "pattern": "^[a-z_]+\\.[a-z0-9_]+$" },
          "rule_version": { "type": "string" },
          "title": { "type": "string" },
          "category": {
            "type": "string",
            "enum": [
              "campaign",
              "contacts",
              "suppression",
              "personalization",
              "copy",
              "schedule",
              "senders"
            ]
          },
          "severity": {
            "type": "string",
            "enum": ["INFO", "LOW", "MEDIUM", "HIGH", "BLOCKER"]
          },
          "status": {
            "type": "string",
            "enum": ["PASS", "WARN", "FAIL", "UNKNOWN", "NOT_APPLICABLE"]
          },
          "heuristic": { "type": "boolean" },
          "summary": { "type": "string" },
          "explanation": { "type": "string" },
          "affected_record_count": { "type": "integer", "minimum": 0 },
          "affected_record_samples": { "type": "array", "items": { "type": "string" } },
          "evidence": { "type": "array", "items": { "type": "string" } },
          "remediation": { "type": "string" },
          "metadata": { "type": "object" }
        }
      }
    },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "redacted": { "type": "boolean" },
    "duration_seconds": { "type": "number", "minimum": 0 }
  }
}
