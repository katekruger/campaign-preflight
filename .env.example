# Campaign Preflight environment variables.
# Copy to .env for local use. .env is gitignored; never commit a real key.

# --- Instantly.ai -----------------------------------------------------------
# A v2 API key (Settings -> Integrations -> API in the Instantly app).
# v1 keys do not work; v2 is a separate API with its own keys and scopes.
#
# Required only for `campaign-preflight instantly` and the
# `preflight_instantly_campaign` MCP tool. The demo and file-based checks need
# nothing.
#
# This is read from the environment ONLY. There is deliberately no --api-key
# flag: a key on the command line lands in shell history, ps output, and CI logs.
INSTANTLY_API_KEY=

# Override the API base URL. For tests and staging only.
# INSTANTLY_BASE_URL=https://api.instantly.ai

# --- MCP server -------------------------------------------------------------
# Log level for the stdio server. Logs go to stderr; stdout belongs to the
# transport. One of DEBUG, INFO, WARNING, ERROR, CRITICAL.
# CAMPAIGN_PREFLIGHT_LOG_LEVEL=WARNING

# --- File handling ----------------------------------------------------------
# Set to 1 to allow reading through a symlink. Off by default so a symlink
# planted in a shared directory cannot redirect a read.
# CAMPAIGN_PREFLIGHT_ALLOW_SYMLINKS=0

# --- Optional claim evaluation ----------------------------------------------
# The LLM claim evaluator is DISABLED by default and no lead data leaves your
# machine. Enable it only in your config file (evidence.evaluator), and only if
# you accept sending claim text to an external service.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
