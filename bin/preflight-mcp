#!/bin/sh
# Campaign Preflight MCP server launcher for the Cowork plugin.
#
# Finds a usable Python 3.9+ and runs the bundled engine from it. The engine has
# no third-party dependencies, so any interpreter that meets the version floor
# works -- no virtualenv, no pip install, no network.
set -eu

PLUGIN_DIR="$(cd "$(dirname "$0")/.." && pwd)"
ENGINE_DIR="$PLUGIN_DIR/engine"

find_python() {
    for candidate in python3 /usr/bin/python3 /usr/local/bin/python3 /opt/homebrew/bin/python3 python; do
        if command -v "$candidate" >/dev/null 2>&1; then
            if "$candidate" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 9) else 1)' 2>/dev/null; then
                echo "$candidate"
                return 0
            fi
        fi
    done
    return 1
}

PYTHON="$(find_python)" || {
    echo "campaign-preflight: no Python 3.9 or newer found." >&2
    echo "Install Python 3 from https://www.python.org/downloads/ and try again." >&2
    exit 6
}

PYTHONPATH="$ENGINE_DIR${PYTHONPATH:+:$PYTHONPATH}" exec "$PYTHON" -X utf8 -m campaign_preflight.mcp.server "$@"
